pkgname=rssstv-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="SSTV for amateur radio"
arch=('x86_64')
url="https://github.com/kb10uy/rssstv"
license=('LGPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'alsa-lib' 'libxkbcommon' 'libxkbcommon-x11'
         'libgl' 'wayland' 'libx11' 'hicolor-icon-theme')
optdepends=('xdg-utils: open the manual and the image folders'
            'noto-fonts: interface font'
            'noto-fonts-cjk: interface font for Japanese'
            'ttf-dejavu: interface fallback font')
provides=('rssstv')
conflicts=('rssstv')
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/rssstv-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('b2458bcb91794a5bfa560b4f841916a090440f1d5c829cf408f11c93ce151f48')

package() {
  cd "rssstv-v$pkgver-x86_64-unknown-linux-gnu"
  install -Dm755 rssstv "$pkgdir/usr/bin/rssstv"
  install -Dm644 assets/rssstv.desktop "$pkgdir/usr/share/applications/rssstv.desktop"
  install -Dm644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/rssstv.png"
  install -Dm644 licenses.html "$pkgdir/usr/share/doc/rssstv/licenses.html"
  install -dm755 "$pkgdir/usr/share/doc/rssstv/help"
  install -m644 help/* "$pkgdir/usr/share/doc/rssstv/help/"
}
