// MMSSTV `def5.mtm`, ported.
//
// Fonts: Arial, Comic Sans MS.
//
// The `73` was painted in the template's transparent color and embossed, so
// the picture showed through the glyphs and only their edges were drawn.
// RSSSTV composites with alpha instead of keying a color out, so the same
// reading is had from a transparent fill behind a white outline.
//
// The lower call line was extruded down and to the left. It keeps the white
// outline the extrusion was drawn with and loses the extrusion itself.

text "73" {
    position x=(fw)3 y=(fh)100 anchor="bottom-left"
    font family="Arial" size=(fh)22.7 weight=700
    fill color="#ffffff00"
    stroke color="#ffffff" width=(em)0.034
}

text "${station.callsign}" {
    position x=(fw)98.1 y=(fh)1 anchor="top-right"
    font family="Arial" size=(fh)7 weight=700
    fill color="#ffffff"
    stroke color="#000000" width=(em)0.111
}

text "${contact.callsign} de ${station.callsign}" {
    position x=(fw)97.2 y=(fh)95.7 anchor="bottom-right"
    font family="Comic Sans MS" size=(fh)8.6 weight=700
    fill color="#ff0000"
    stroke color="#ffffff" width=(em)0.091
}
